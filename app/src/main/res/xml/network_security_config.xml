<?xml version="1.0" encoding="utf-8"?>
<!--
    Many free-to-air IPTV streams are still served over plain HTTP, so cleartext
    traffic is allowed for this application.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
