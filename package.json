{
  "name": "mahva-android-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "مهوا؛ دستیار گفت‌وگوی هوشمند و اپلیکیشن قابل نصب اندروید",
  "scripts": {
    "serve": "python3 -m http.server 4173 --bind 0.0.0.0 --directory www",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9"
  }
}
